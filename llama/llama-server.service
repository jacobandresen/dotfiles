[Unit]
Description=Local Ministral llama.cpp server
After=graphical-session.target

[Service]
ExecStart=%h/.local/bin/llama-server -m %h/.local/share/llama/models/ministral-3b-instruct-q4_k_m.gguf --device Vulkan0 --n-gpu-layers 99 --ctx-size 16384 --host 127.0.0.1 --port 11435
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
