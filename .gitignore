# Legacy Pi runtime data retained during migration to a host-local ~/.pi directory
pi/agent/sessions/

# Legacy host-managed settings; new installs keep this outside the repository.
pi/agent/settings.json

# Runtime/host state — contains live OAuth tokens and per-machine data, not config
pi/agent/auth.json
pi/agent/trust.json
pi/agent/models-store.json

# pi auto-vendors helper binaries here if missing from PATH — install them
# properly instead (e.g. `fd` via the system package manager)
pi/agent/bin/

# Pi-managed installation and bundled dependencies
pi/agent/install/

# Go telemetry runtime data
go/telemetry/

# Editor
*.swp
*.swo
.viminfo
.viminfo.tmp
kitty/*.bak
# Dadbod UI stores personal database URLs here when XDG_DATA_HOME points into
# this checkout. The normal location is outside the repository.
**/db_ui/connections.json

# OS
.DS_Store
Thumbs.db

# Shell
.zsh_history

# Python
__pycache__/
*.py[cod]

# Environment
.env
*.env.local

# Neovim log written to the working directory when launched from the repo root
nvim.log
