# GNOME Terminal Retrobox profile, aligned with kitty/current-theme.conf.
[b1f3c2a4-90d7-4e6a-a3bc-5e2f4f8a9d10]
visible-name='Retrobox'
use-theme-colors=false
foreground-color='#ebdbb2'
background-color='#1c1c1c'
bold-color='#fbf1c7'
bold-color-same-as-fg=false
palette=['#1d2021', '#cc241d', '#98971a', '#d79921', '#458588', '#b16286', '#689d6a', '#a89984', '#928374', '#fb5944', '#b8bb26', '#fabd2f', '#83a598', '#d3869b', '#8ec07c', '#fbf1c7']
use-theme-transparency=false
use-transparent-background=false
cursor-colors-set=true
cursor-background-color='#fabd2f'
cursor-foreground-color='#1c1c1c'
highlight-colors-set=true
highlight-background-color='#98971a'
highlight-foreground-color='#1c1c1c'
