# Ollama env for an 8GB macOS machine (Apple silicon, unified memory).
# Applied with `launchctl setenv` by scripts/install-ollama-macos.sh.
#
# macOS itself holds 3-4GB, so the budget for a model + KV cache is ~3GB.
# Metal supports KV cache quantization (unlike the Vulkan iGPU path on
# Linux), so q8_0 is on here: it roughly halves KV cache RAM for free.
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
