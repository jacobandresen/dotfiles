# Ollama env for an 8GB macOS machine (Apple silicon, unified memory).
# Applied with `launchctl setenv` by scripts/install-ollama-macos.sh.
#
# macOS itself holds 3-4GB, so the budget for a model + KV cache is ~4GB.
# The selected model (qwen3:4b) is 3.9GB resident with this 16K window and
# still sits 100% on the GPU. The previous pick was 6.3GB and spilled.
#
# 16384, not 8192: pi's system prompt and tool schemas are ~1.7K tokens
# before any work happens, and one compile-fix-recompile loop with the error
# output pasted back in walks straight through an 8K window. Truncating
# mid-loop is how the agent "forgets" the file it just wrote.
#
# Metal supports KV cache quantization (unlike the Vulkan iGPU path on
# Linux), so q8_0 is on here: it roughly halves KV cache RAM, which is what
# pays for the larger window. Note the Ollama.app menubar server sets q8_0 by
# itself and ignores this file's value entirely — see the header of
# scripts/install-ollama-macos.sh. Only OLLAMA_CONTEXT_LENGTH below actually
# reaches that server, and only because the installer writes it into the
# app's own settings store.
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_NUM_PARALLEL=1
